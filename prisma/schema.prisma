generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("PRISMA_DATABASE_URL")
  directUrl = env("POSTGRES_URL")
}

model User {
  id              String            @id @default(cuid())
  email           String            @unique
  name            String?
  passwordHash    String?
  image           String?
  age             Int?
  weightKg        Float?
  runningGoal     String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  runs            Run[]
  comments        Comment[]
  likes           Like[]
  connected       ConnectedAccount[]
  aiReports       AIReport[]
  leaderboardLikes LeaderboardLike[]
}

model Run {
  id            String   @id @default(cuid())
  user          User     @relation(fields: [userId], references: [id])
  userId        String
  date          DateTime
  distanceKm    Float
  durationSec   Int
  paceSecPerKm  Int
  avgHeartRate  Int?
  elevationGain Float?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  activity      Activity?
  aiReport      AIReport?
  comments      Comment[]
  likes         Like[]
}

model Activity {
  id            String   @id @default(cuid())
  run           Run?     @relation(fields: [runId], references: [id])
  runId         String?  @unique
  source        String
  externalId    String
  rawJson       Json
  createdAt     DateTime @default(now())
}

model Leaderboard {
  id        String   @id @default(cuid())
  type      String
  period    DateTime
  entries   Json
  createdAt DateTime @default(now())
}

model Comment {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  run       Run      @relation(fields: [runId], references: [id])
  runId     String
  text      String
  createdAt DateTime @default(now())
}

model Like {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  run       Run      @relation(fields: [runId], references: [id])
  runId     String
  createdAt DateTime @default(now())
}

model AIReport {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  run       Run?     @relation(fields: [runId], references: [id])
  runId     String?  @unique
  summary   String
  details   Json?
  createdAt DateTime @default(now())
}

model ConnectedAccount {
  id            String   @id @default(cuid())
  user          User     @relation(fields: [userId], references: [id])
  userId        String
  provider      String
  providerId    String
  accessToken   String?
  refreshToken  String?
  expiresAt     Int?
  createdAt     DateTime @default(now())
}

model ClubStats {
  id          String   @id @default(cuid())
  totalDistanceKm Float @default(0)
  activeUsers Int     @default(0)
  createdAt   DateTime @default(now())
}

model LeaderboardLike {
  id              String   @id @default(cuid())
  user            User     @relation(fields: [userId], references: [id])
  userId          String
  leaderboardType String
  targetUserId    String
  createdAt       DateTime @default(now())

  @@unique([userId, leaderboardType, targetUserId])
}
