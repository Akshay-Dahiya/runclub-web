generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("PRISMA_DATABASE_URL")
}

model User {
  id              String            @id @default(cuid())
  email           String            @unique
  name            String?
  initials        String?
  passwordHash    String?
  image           String?
  age             Int?
  weightKg        Float?
  runningGoal     String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  runs            Run[]
  comments        Comment[]
  likes           Like[]
  connected       ConnectedAccount[]
  aiReports       AIReport[]
  leaderboardLikes LeaderboardLike[]
  checklistItems  ChecklistItem[]
  coachProfile    CoachProfile?
  trainingPlans   TrainingPlan[]
  garminMetrics   GarminDailyMetric[]
  garminActivities GarminActivity[]
  garminCredential GarminIngestCredential?

  // Strava integration columns
  strava_athlete_id       BigInt?
  strava_access_token     String?
  strava_refresh_token    String?
  strava_token_expires_at DateTime?
  strava_connected        Boolean           @default(false)
  last_synced_at          DateTime?
}

// ─── AI Coach models ───────────────────────────────────────────────────────────

model CoachProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Step 1 — Running history
  pb5kSec         Int?
  pb10kSec        Int?
  pbHMSec         Int?
  pbMarathonSec   Int?
  hasRacedBefore  Boolean  @default(false)
  lastRaceDate    DateTime?
  weeklyKmCurrent Float?
  yearsRunning    Float?

  // Step 2 — Availability
  daysPerWeek     Int?
  strengthDays    Int?     @default(0)
  hasGym          Boolean  @default(false)
  treadmillAccess Boolean  @default(false)
  outdoorAccess   Boolean  @default(true)
  sessionMinutes  Int?

  // Step 3 — Current fitness
  easyPaceSec     Int?
  avgEasyKm       Float?
  longestLast30   Float?
  hasHRMonitor    Boolean  @default(false)
  restingHR       Int?

  // Step 4 — Injury & recovery
  currentInjury   String?
  recurringInjury String?
  prefersWalkRun  Boolean  @default(false)
  sleepHours      Float?

  // Step 5 — Goal
  goalRace        String?
  goalRaceDate    DateTime?
  goalTimeSec     Int?
  isFirstRace     Boolean  @default(false)

  activePlanId    String?
  onboardingDone  Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model TrainingPlan {
  id              String     @id @default(cuid())
  userId          String
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  goalRace        String
  goalTimeSec     Int
  goalRaceDate    DateTime?
  weeksTotal      Int
  currentWeek     Int        @default(1)
  status          String     @default("active")
  planData        Json       // full plan serialized from training-engine
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  weeklyReviews   WeeklyReview[]
}

model WeeklyReview {
  id              String       @id @default(cuid())
  planId          String
  plan            TrainingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  userId          String
  weekNumber      Int
  kmPlanned       Float
  kmCompleted     Float
  workoutsPlanned Int
  workoutsDone    Int
  avgPaceSec      Int?
  avgHR           Int?
  aiSummary       String       @db.Text
  nextWeekFocus   String       @db.Text
  createdAt       DateTime     @default(now())

  @@unique([planId, weekNumber])
}

model Run {
  id            String   @id @default(cuid())
  user          User     @relation(fields: [userId], references: [id])
  userId        String
  date          DateTime
  distanceKm    Float
  durationSec   Int
  paceSecPerKm  Int
  avgHeartRate  Int?
  elevationGain Float?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  activity      Activity?
  aiReport      AIReport?
  comments      Comment[]
  likes         Like[]
  garminActivity GarminActivity?

  // Strava integration columns
  source             String   @default("manual")
  strava_activity_id BigInt?
}

model Activity {
  id            String   @id @default(cuid())
  run           Run?     @relation(fields: [runId], references: [id])
  runId         String?  @unique
  source        String
  externalId    String
  rawJson       Json
  createdAt     DateTime @default(now())
}

model GarminDailyMetric {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime
  data      Json
  createdAt DateTime @default(now())

  @@unique([userId, date])
  @@index([userId, date])
}

model GarminActivity {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  externalId String
  runId      String?  @unique
  run        Run?     @relation(fields: [runId], references: [id], onDelete: SetNull)
  data       Json
  date       DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, externalId])
  @@index([userId, date])
}

model GarminIngestCredential {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Leaderboard {
  id        String   @id @default(cuid())
  type      String
  period    DateTime
  entries   Json
  createdAt DateTime @default(now())
}

model Comment {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  run       Run      @relation(fields: [runId], references: [id])
  runId     String
  text      String
  createdAt DateTime @default(now())
}

model Like {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  run       Run      @relation(fields: [runId], references: [id])
  runId     String
  createdAt DateTime @default(now())
}

model AIReport {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  run       Run?     @relation(fields: [runId], references: [id])
  runId     String?  @unique
  summary   String
  details   Json?
  createdAt DateTime @default(now())
}

model ConnectedAccount {
  id            String   @id @default(cuid())
  user          User     @relation(fields: [userId], references: [id])
  userId        String
  provider      String
  providerId    String
  accessToken   String?
  refreshToken  String?
  expiresAt     Int?
  createdAt     DateTime @default(now())
}

model ClubStats {
  id          String   @id @default(cuid())
  totalDistanceKm Float @default(0)
  activeUsers Int     @default(0)
  createdAt   DateTime @default(now())
}

model LeaderboardLike {
  id              String   @id @default(cuid())
  user            User     @relation(fields: [userId], references: [id])
  userId          String
  leaderboardType String
  targetUserId    String
  createdAt       DateTime @default(now())

  @@unique([userId, leaderboardType, targetUserId])
}

model ChecklistItem {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  itemKey   String
  checked   Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@unique([userId, itemKey])
}

model AdminNote {
  id        String   @id @default(cuid())
  content   String   @default("")
  updatedAt DateTime @updatedAt
}

model PlanOverride {
  id    String @id @default(cuid())
  plan  String
  week  Int
  day   String
  km    Float

  @@unique([plan, week, day])
}
